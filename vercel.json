{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/" }
  ],
  "functions": {
    "api/connect/composio/auth.js":       { "memory": 256 },
    "api/connect/composio/disconnect.js": { "memory": 256 },
    "api/connect/composio/preview.js":    { "memory": 256 },
    "api/connect/disconnect.js":          { "memory": 256 },
    "api/connect/status.js":              { "memory": 256 },
    "api/counsel.js":                     { "memory": 512, "maxDuration": 60 },
    "api/vapi/webhook.js":                { "memory": 512, "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/sync-connectors",      "schedule": "30 5 * * *" },
    { "path": "/api/intelligence-synthesis",    "schedule": "0 6 * * *" },
    { "path": "/api/cron/business-health",      "schedule": "0 8 * * *" },
    { "path": "/api/cron/weekly-digest",        "schedule": "0 9 * * 1" }
  ]
}
