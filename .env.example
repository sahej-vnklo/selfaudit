# Supabase project credentials (required for auth)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — publishable key is used client-side
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Claude API key (used client-side for audit conversations)
VITE_CLAUDE_API_KEY=sk-ant-...

# Resend API key (server-side, for report email delivery)
RESEND_API_KEY=re_...

# ─── Supabase Edge Function secrets ─────────────────────────────────────────
# Set these in Supabase: Settings → Edge Functions → Secrets

STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ESSENTIAL=price_...
STRIPE_PRICE_BUSINESS=price_...
STRIPE_PRICE_PORTFOLIO=price_...

# Sentry — error monitoring (client-side)
VITE_SENTRY_DSN=https://your-dsn@sentry.io/...

# Connector OAuth credentials
APP_URL=https://tryselfaudit.com
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
